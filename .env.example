# Copy this file to .env.local and fill in what you have. Every line is optional.

# TypeSafe Jev: first pass on category and owner for payees with no rule.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Claude Sonnet: second opinion when Jev is unsure, and reads unusual statement layouts.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Ask for a password in the browser. Set this if anyone else can reach the app.
APP_PASSWORD=

# Database. Create one at turso.tech, then paste its URL and a token.
#   turso db create finance-dashboard
#   turso db show finance-dashboard --url
#   turso db tokens create finance-dashboard
# Leave both empty to use a local file in ./data instead (handy for trying it out).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATA_DIR=
