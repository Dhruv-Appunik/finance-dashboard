# Copy this file to .env.local and fill in what you have. Every line is optional.

# TypeSafe Jev: first pass on category and owner for payees with no rule.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Claude Sonnet: second opinion when Jev is unsure, and reads unusual statement layouts.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Ask for a password in the browser. Set this if anyone else can reach the app.
APP_PASSWORD=

# Where the SQLite database lives. Defaults to ./data
# DATA_DIR=
